.detail-page {
  padding: 24rpx 24rpx 160rpx;
}

.article-box {
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  padding: 32rpx 30rpx;
}

.article-tags { display: flex; gap: 10rpx; margin-bottom: 14rpx; }

.top-badge {
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.cat-badge {
  background: var(--bg-soft);
  color: var(--text-2);
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.article-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.45;
  letter-spacing: 1rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 22rpx;
  color: var(--text-3);
  font-size: 24rpx;
  margin-top: 18rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid var(--border);
}

.article-content {
  padding-top: 24rpx;
  font-size: 32rpx;
  line-height: 1.8;
  letter-spacing: 0.01rem;
  color: var(--text);
  word-break: break-all;
}

.copy-line {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border);
  text-align: right;
  color: var(--brand);
  font-size: 24rpx;
}
.copy-line:active { opacity: .7; }

/* 留言区 */
.comment-box {
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  padding: 30rpx;
  margin-top: 20rpx;
}

.comment-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
}

.comment-count { color: var(--text-3); font-size: 24rpx; font-weight: 400; margin-left: 8rpx; }
.guest-hint {
  margin: -4rpx 0 18rpx;
  padding: 12rpx 16rpx;
  background: var(--bg-soft);
  border-radius: 6rpx;
  color: var(--text-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.comment-empty { color: var(--text-3); text-align: center; padding: 40rpx 0; font-size: 26rpx; }

.comment-item {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--border);
}
.comment-item:last-child { border-bottom: none; }

.comment-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
  overflow: hidden;
}

.comment-avatar image { width: 100%; height: 100%; }

.comment-main { flex: 1; min-width: 0; }

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-name { font-weight: 600; font-size: 27rpx; color: var(--text); }
.comment-time { color: var(--text-3); font-size: 22rpx; }

.comment-content { margin-top: 8rpx; color: var(--text-2); font-size: 27rpx; line-height: 1.8; }

.comment-reply {
  margin-top: 12rpx;
  background: var(--bg-soft);
  border-left: 6rpx solid var(--brand);
  border-radius: 6rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.8;
}

.reply-label { color: var(--brand); font-weight: 600; }

/* 底部输入栏 */
.comment-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-top: 2rpx solid var(--border);
  padding: 16rpx 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.comment-input {
  flex: 1;
  background: var(--bg-soft);
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 0 28rpx;
  height: 76rpx;
  font-size: 28rpx;
  color: var(--text);
  transition: border-color .2s;
}
.comment-input:focus { border-color: var(--brand); background: var(--card); }

.comment-submit {
  background: var(--brand);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  padding: 0 36rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  margin: 0;
}
.comment-submit:active { opacity: .8; }
.comment-submit[disabled] { opacity: .5; }

.detail-loading { text-align: center; color: var(--text-3); padding: 200rpx 0; }