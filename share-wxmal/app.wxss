page {
  background: #f8fafc;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1e293b;
  font-size: 32rpx;
  line-height: 1.8;
  letter-spacing: 0.01rem;
}

/* 主题变量：浅色（默认）/ 深色 */
.app {
  --bg: #f8fafc;
  --bg-soft: #f1f5f9;
  --card: #ffffff;
  --text: #1e293b;
  --text-2: #64748b;
  --text-3: #94a3b8;
  --border: #e2e8f0;
  --brand: #3b82f6;
  --brand-soft: #eff6ff;
  --danger: #dc2626;
  --danger-soft: #fef2f2;
  --success: #059669;
  --success-soft: #ecfdf5;
  --warning: #d97706;
  --warning-soft: #fffbeb;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.app-dark {
  --bg: #1e293b;
  --bg-soft: rgba(148, 163, 184, 0.08);
  --card: #263449;
  --text: #e2e8f0;
  --text-2: #94a3b8;
  --text-3: #64748b;
  --border: rgba(148, 163, 184, 0.16);
  --brand: #3b82f6;
  --brand-soft: rgba(59, 130, 246, 0.14);
  --danger: #f87171;
  --danger-soft: rgba(248, 113, 113, 0.12);
  --success: #34d399;
  --success-soft: rgba(52, 211, 153, 0.12);
  --warning: #fbbf24;
  --warning-soft: rgba(251, 191, 36, 0.12);
}

button {
  border-radius: 12rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
